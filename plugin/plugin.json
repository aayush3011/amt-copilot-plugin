{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "amt-memory",
  "description": "Persistent, scoped agent memory (personal, team, org) backed by Azure Cosmos DB, delivered through the Inference Platform gateway.",
  "version": "0.7.2",
  "author": {
    "name": "Aayush Kataria",
    "url": "https://github.com/aayush3011"
  },
  "repository": "https://github.com/aayush3011/amt-copilot-plugin",
  "license": "MIT",
  "keywords": [
    "amt",
    "agent-memory",
    "cosmos-db",
    "mcp",
    "canvas",
    "memory"
  ],
  "skills": [
    "skills/amt-import/",
    "skills/amt-login/",
    "skills/amt-logout/",
    "skills/memory-show/",
    "skills/use-memory/"
  ],
  "hooks": "hooks/hooks.json",
  "mcpServers": "mcp.json",
  "extensions": {
    "com.github.copilot": {
      "extensions": [
        "./com.github.copilot/extensions/memory-canvas"
      ]
    }
  }
}
