{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "./com.github.copilot/scripts/inject.sh",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "./com.github.copilot/scripts/capture.sh",
        "timeoutSec": 20
      }
    ]
  }
}
