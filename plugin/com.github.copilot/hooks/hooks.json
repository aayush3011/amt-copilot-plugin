{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT}/com.github.copilot/scripts/inject.sh\"",
        "powershell": "& \"${PLUGIN_ROOT}/com.github.copilot/scripts/inject.ps1\"",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT}/com.github.copilot/scripts/capture.sh\"",
        "powershell": "& \"${PLUGIN_ROOT}/com.github.copilot/scripts/capture.ps1\"",
        "timeoutSec": 20
      }
    ]
  }
}
