    "tool_input": {"files": ["src/example.ts"]},
    "tool_response": "DO_NOT_CAPTURE_TOOL_OUTPUT"
  },
  "stop": {
    "session_id": "same-session",
    "hook_event_name": "Stop",
    "stop_hook_active": false,
    "last_assistant_message": "The focused tests pass."
  }
