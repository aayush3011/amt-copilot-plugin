{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT}/com.github.copilot/scripts/inject.sh\"",
        "powershell": "& \"${PLUGIN_ROOT}/com.github.copilot/scripts/inject.ps1\"",
        "env": {
          "AMT_HOOK_PHASE": "capture"
        },
        "timeoutSec": 30
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT}/com.github.copilot/scripts/inject.sh\"",
        "powershell": "& \"${PLUGIN_ROOT}/com.github.copilot/scripts/inject.ps1\"",
        "env": {
          "AMT_HOOK_PHASE": "recall"
        },
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": ".*enroll_hook_capture",
        "bash": "\"${PLUGIN_ROOT}/com.github.copilot/scripts/complete-login.sh\"",
        "powershell": "& \"${PLUGIN_ROOT}/com.github.copilot/scripts/complete-login.ps1\"",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT}/com.github.copilot/scripts/capture.sh\"",
        "powershell": "& \"${PLUGIN_ROOT}/com.github.copilot/scripts/capture.ps1\"",
        "timeoutSec": 20
      }
    ]
  }
}
